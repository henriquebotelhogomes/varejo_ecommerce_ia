# =====================================================================
# RetailSense AI — Variáveis de Ambiente & Configurações
# =====================================================================

# 1. Provedores de Modelos de IA (Configure ao menos um)
# Google Gemini Pro (Recomendado — Alta cota e baixa latência)
GEMINI_API_KEY=sua_chave_gemini_aqui

# OpenCode Go (DeepSeek V4.1 Flash, DeepSeek V4 Pro, Qwen 3.x)
OPENCODE_API_KEY=sua_chave_opencode_aqui
OPENCODE_BASE_URL=https://api.opencode.ai/v1

# Groq (Opcional / Fallback)
GROQ_API_KEY=sua_chave_groq_aqui

# 2. Observabilidade & Tracing (Opcional)
LANGFUSE_PUBLIC_KEY=sua_langfuse_public_key
LANGFUSE_SECRET_KEY=sua_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

LANGSMITH_API_KEY=sua_langsmith_api_key
LANGCHAIN_PROJECT=retailsense-ai

# 3. Servidor & Deploy
PORT=8000
GCP_PROJECT_ID=seu-projeto-gcp
GCP_REGION=us-central1
